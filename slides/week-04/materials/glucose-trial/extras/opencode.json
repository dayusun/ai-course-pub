{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "nrp": {
      "models": {
        "qwen3-small": {
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "wc *": "allow",
      "head *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "Rscript *": "allow",
      "python3 *": "allow",
      "rm *": "deny",
      "chmod *": "deny",
      "git push*": "deny"
    }
  }
}
